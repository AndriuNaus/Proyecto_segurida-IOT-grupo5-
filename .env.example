# Clave de firmas JWT
JWT_SECRET=tu-clave-secreta-larga-para-firmar-tokens

# ESP32-CAM Stream URL (o 'push')
ESP32_CAM_URL=https://iot-security.pro/api/camera/stream

# Puerto del servidor
PORT=3000

# Credenciales de Supabase (PostgreSQL en la Nube) — TU proyecto
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-de-supabase
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-supabase

# Credenciales de Telegram (Para alertas)
TELEGRAM_BOT_TOKEN=tu-token-de-telegram-bot
TELEGRAM_CHAT_ID=tu-chat-id-de-telegram

# Supabase del COMPAÑERO — para verificar tokens de su auth en /api/camera/stream-token
# Estas claves son públicas (el frontend de él las usa en el navegador, no son secretas)
# Pídele a tu compañero el SUPABASE_URL y SUPABASE_ANON_KEY de su proyecto
COMPANION_SUPABASE_URL=https://proyecto-del-companero.supabase.co
COMPANION_SUPABASE_ANON_KEY=clave-anon-publica-del-companero
